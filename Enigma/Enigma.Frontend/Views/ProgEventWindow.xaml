<Window x:Class="Enigma.Frontend.Ui.Views.ProgEventWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewModels="clr-namespace:Enigma.Frontend.Ui.ViewModels"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Medium"
        TextElement.FontSize="14"
        FontFamily="pack://application:,,,/MaterialDesignThemes.Wpf;component/Resources/Roboto/#Roboto"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"        
        Title="Enigma - Event for progressions" Height="760" Width="520">
    <Window.Resources>
        <viewModels:ProgEventViewModel x:Key="ViewModel"/>
    </Window.Resources>
    <Grid Margin="6"  DataContext="{StaticResource ViewModel}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="78*"/>
            <ColumnDefinition Width="22*"/>
        </Grid.ColumnDefinitions>            
        <Grid.RowDefinitions>
            <RowDefinition Height="8*"/>
            <RowDefinition Height="8*"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="8*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="6,0,0, 6" VerticalAlignment="Center" HorizontalAlignment="Left"
                   Text="Define and save event" Name="Header"
                   Style="{StaticResource MaterialDesignHeadline4TextBlock}" FontWeight="Bold" />
        <TextBox Grid.Row="1"  Grid.Column="0" Grid.ColumnSpan="2" Margin="6 " VerticalAlignment="Center" 
                 materialDesign:HintAssist.Hint="Description of event" 
                 TextWrapping="Wrap" Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                 Text="{Binding Description, Mode = TwoWay}"/>
        
        
        <!-- Date and time -->
        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="6 12 6 0" 
                   Text="Date and time" Name="SubHeaderDateTime" 
                   Style="{StaticResource MaterialDesignHeadline6TextBlock}" FontWeight="Bold"/>
        <TextBox Grid.Row="3" Grid.Column="0" Margin="6 0" VerticalAlignment="Center"  Grid.ColumnSpan="2"                  
                 materialDesign:HintAssist.Hint="Date yyyy/mm/dd"
                 Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                 BorderBrush="{Binding DateValid}"
                 Text="{Binding Date}"/>  
        <ComboBox Grid.Row="4" Grid.Column="0" Margin="6 0" VerticalAlignment="Center" 
                  IsEditable="True" IsReadOnly="True"
                  materialDesign:HintAssist.Hint="Calendar"
                  Style="{StaticResource MaterialDesignFloatingHintComboBox }" 
                  ItemsSource="{Binding AllCalendars}"
                  SelectedIndex="{Binding CalendarIndex, Mode=TwoWay}" />
        <ComboBox Grid.Row="4" Grid.Column="1" Margin="6 0" VerticalAlignment="Center" 
                  Text=""  IsEditable="True" IsReadOnly="True"
                  materialDesign:HintAssist.Hint="Yearcount"
                  Style="{StaticResource MaterialDesignFloatingHintComboBox }" 
                  ItemsSource="{Binding AllYearCounts}"
                  SelectedIndex="{Binding YearCountIndex, Mode=TwoWay}" />
        <TextBox Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="6 0" VerticalAlignment="Center" 
                 materialDesign:HintAssist.Hint="Time hh:mm:ss"
                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                 BorderBrush="{Binding TimeValid}"
                 Text="{Binding Time}"/>  
        
                <!-- Location -->
        <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Margin="6 12 6 0" 
                   Text="Location" Name="SubHeaderLocation"  
                   Style="{StaticResource MaterialDesignHeadline6TextBlock}" FontWeight="Bold"/>
        <ComboBox Grid.Row="7" Grid.Column="0"  
                  ItemsSource="{Binding AllCountries, UpdateSourceTrigger=PropertyChanged}"
                  VerticalAlignment="Center" 
                  SelectedItem="{Binding SelectedCountry, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  DisplayMemberPath="Name"
                  materialDesign:HintAssist.Hint="Select a country"
                  Margin="6, 0"
                  IsEditable="False"
                  IsTextSearchEnabled="True"
                  StaysOpenOnEdit="False"/>
        
        <ComboBox Grid.Row="8" Grid.Column="0" 
                  ItemsSource="{Binding CitiesForCountry, UpdateSourceTrigger=LostFocus}"
                  SelectedItem="{Binding SelectedCity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  DisplayMemberPath="Name"
                  VerticalContentAlignment="Center"
                  materialDesign:HintAssist.Hint="Select a city after selecting a country"
                  Margin="6,0"
                  IsEditable="False"
                  IsTextSearchEnabled="True"
                  StaysOpenOnEdit="True"/>
        <TextBox Grid.Row="9" Grid.Column="0" Margin="6 0" VerticalAlignment="Center"   
                 materialDesign:HintAssist.Hint="Longitude ddd:mm:ss"
                 Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                 BorderBrush="{Binding GeoLongValid}"
                 Text="{Binding GeoLong, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        <ComboBox Grid.Row="9" Grid.Column="1" IsEditable="True" IsReadOnly="True"
                  materialDesign:HintAssist.Hint="East/West"
                  VerticalAlignment="Center" Margin="6 0"
                  Style="{StaticResource MaterialDesignFloatingHintComboBox }" 
                  ItemsSource="{Binding AllDirectionsForLongitude}"
                  SelectedIndex="{Binding DirLongIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBox Grid.Row="10" Grid.Column="0" Margin="6 0" VerticalAlignment="Center" 
                 materialDesign:HintAssist.Hint="Latitude dd:mm:ss"
                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                 BorderBrush="{Binding GeoLatValid}"
                 Text="{Binding GeoLat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        <ComboBox Grid.Row="10" Grid.Column="1" IsEditable="True" IsReadOnly="True"
                  materialDesign:HintAssist.Hint="North/South"
                  VerticalAlignment="Center" Margin="6 0"
                  Style="{StaticResource MaterialDesignFloatingHintComboBox }" 
                  ItemsSource="{Binding AllDirectionsForLatitude}"
                  SelectedIndex="{Binding DirLatIndex, Mode=TwoWay}" />
        <!-- TimeZone -->
        <TextBlock Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="2" Margin="6 12 6 0" 
                   Text="TimeZone" Name="SubHeaderTimeZone"  
                   Style="{StaticResource MaterialDesignHeadline6TextBlock}" FontWeight="Bold"/>
        <TextBox Grid.Row="12" Grid.Column="0" Margin="6 0" VerticalAlignment="Center" 
                 materialDesign:HintAssist.Hint="TimeZone (hh:mm:ss)"
                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                 BorderBrush="{Binding TimeZoneValid}"
                 Text="{Binding TimeZone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        <CheckBox Grid.Row="12" Grid.Column="1" VerticalAlignment="Center" IsTabStop="False" Content="Apply DST"  
                  Style="{StaticResource MaterialDesignCheckBox}"
                  IsChecked="{Binding ApplyDst}" />
        <StackPanel Grid.Row="13" Grid.Column="0" Grid.ColumnSpan="2" Margin="6" Orientation="Horizontal" 
                    HorizontalAlignment="Right">
            <Button Margin="6" Content="Help" HorizontalAlignment="Right" 
                    Command="{Binding HelpCommand}"/>
            <Button Margin="6" Content="Cancel" HorizontalAlignment="Right" 
                    Command="{Binding CancelCommand}"/>
            <Button Name="SaveButton"
                    Margin="6" Content="Save" HorizontalAlignment="Right" 
                    Command="{Binding FinalizeEventCommand}"/>
        </StackPanel>
        
    </Grid>
</Window>
