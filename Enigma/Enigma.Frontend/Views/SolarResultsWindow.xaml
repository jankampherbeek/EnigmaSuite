<Window x:Class="Enigma.Frontend.Ui.Views.SolarResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewModels="clr-namespace:Enigma.Frontend.Ui.ViewModels"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Medium"
        TextElement.FontSize="14"
        FontFamily="pack://application:,,,/MaterialDesignThemes.Wpf;component/Resources/Roboto/#Roboto"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Enigma - Solar Results" Height="900" Width="800">
    <Window.Resources>
        <viewModels:SolarResultsViewModel x:Key="ViewModel"/>
    </Window.Resources>
    <Grid Margin="6" DataContext="{StaticResource ViewModel}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Margin="6,0,0,6" 
                   VerticalAlignment="Center" HorizontalAlignment="Left"
                   Text="Solar results" Name="Header"
                   Style="{StaticResource MaterialDesignHeadline4TextBlock}" 
                   FontWeight="Bold" />

        <!-- Chart Name -->
        <TextBlock Grid.Row="1" Margin="6,12,6,6" 
                   Text="{Binding ChartName}" Name="ChartNameText"
                   Style="{StaticResource MaterialDesignHeadline6TextBlock}" 
                   FontWeight="Bold"/>
        
        <TabControl Grid.Row="2" Margin="6" x:Name="MainTabControl">
            
            <!-- Solar Chart Tab -->
            <TabItem Header="Solar chart">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="80"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Chart Wheel Canvas -->
                    <Grid Grid.Row="0" Grid.RowSpan="2" SizeChanged="WheelGrid_SizeChanged" Margin="0,0,0,121">
                        <Canvas x:Name="WheelCanvas" ClipToBounds="True"/>
                    </Grid>
                    
                    <!-- Chart Options -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="6">
                        <CheckBox Content="No time" Margin="6,0" 
                                  Style="{StaticResource MaterialDesignCheckBox}"
                                  Checked="NoTime_Checked" Unchecked="NoTime_Unchecked"/>
                        <CheckBox Content="No aspects" Margin="6,0" 
                                  Style="{StaticResource MaterialDesignCheckBox}"
                                  Checked="NoAspects_Checked" Unchecked="NoAspects_UnChecked"/>
                        <CheckBox Content="No sign colors" Margin="6,0" 
                                  Style="{StaticResource MaterialDesignCheckBox}"
                                  Checked="SignColors_Checked" Unchecked="SignColors_Unchecked"/>
                    </StackPanel>
                    <Button Grid.Row="2" HorizontalAlignment="Right" Margin="6" Content="Export" Click="ExportClick"/>
                </Grid>
            </TabItem>

            <!-- Positions Tab -->
            <TabItem Header="Positions">
                <Grid Margin="6">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <DataGrid Margin="6"
                                  materialDesign:DataGridAssist.CellPadding="4 2 2 2"
                                  materialDesign:DataGridAssist.ColumnHeaderPadding="4 2 2 2"
                                  CanUserAddRows="False"
                                  CanUserSortColumns="False"
                                  AutoGenerateColumns="False"
                                  HeadersVisibility="All"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Top"
                                  ItemsSource="{Binding SolarPositions}"
                                  SelectionUnit="FullRow">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding PointGlyph}" Header=" " 
                                                    IsReadOnly="True" CellStyle="{StaticResource GlyphColumnStyle}"/>
                                <DataGridTextColumn Binding="{Binding Longitude}" Header="Longitude" 
                                                    IsReadOnly="True" CellStyle="{StaticResource NumberColumnStyle}"/>
                                <DataGridTextColumn Binding="{Binding SignGlyph}" Header=" " 
                                                    IsReadOnly="True" CellStyle="{StaticResource GlyphColumnStyle}"/>
                                <DataGridTextColumn Binding="{Binding Latitude}" Header="Latitude" 
                                                    IsReadOnly="True" CellStyle="{StaticResource NumberColumnStyle}"/>
                                <DataGridTextColumn Binding="{Binding Ra}" Header="Right ascension" 
                                                    IsReadOnly="True" CellStyle="{StaticResource NumberColumnStyle}"/>
                                <DataGridTextColumn Binding="{Binding Declination}" Header="Declination" 
                                                    IsReadOnly="True" CellStyle="{StaticResource NumberColumnStyle}"/>
                            </DataGrid.Columns>   
                        </DataGrid>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Aspects with radix Tab -->
            <TabItem Header="Aspects with radix" x:Name="AspectsTab">
                <StackPanel Orientation="Vertical" Margin="6">
                    <StackPanel Orientation="Horizontal">
                        <TextBox Margin="6 0" 
                                 materialDesign:HintAssist.Hint="Orb for comparison solar with radix"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                 BorderBrush="{Binding OrbSolarValid}"
                                 Text="{Binding OrbSolarText, Mode=TwoWay}" />
                        <Button Margin="6" Content="Re-calculate" HorizontalAlignment="Right" 
                                Command="{Binding ReCalcCommand}"/>                        
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Height="400">
                        <DataGrid Margin="6"
                                  materialDesign:DataGridAssist.CellPadding="4 2 2 2"
                                  materialDesign:DataGridAssist.ColumnHeaderPadding="4 2 2 2"
                                  CanUserAddRows="False"
                                  CanUserSortColumns="False"
                                  AutoGenerateColumns="False"
                                  HeadersVisibility="All"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Top"
                                  ItemsSource="{Binding SolarAspects}"
                                  SelectionUnit="FullRow">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding ProgGlyph}" Header=" " 
                                                    IsReadOnly="True" CellStyle="{StaticResource GlyphColumnStyle}"/>
                                <DataGridTextColumn Binding="{Binding ProgName}" Header="Solar" 
                                                    IsReadOnly="True" CellStyle="{StaticResource NameColumnStyle}"/>
                                <DataGridTextColumn Binding="{Binding AspectGlyph}" Header=" " 
                                                    IsReadOnly="True" CellStyle="{StaticResource GlyphColumnStyle}"/>
                                <DataGridTextColumn Binding="{Binding AspectName}" Header="Aspect" 
                                                    IsReadOnly="True" CellStyle="{StaticResource NameColumnStyle}"/>
                                <DataGridTextColumn Binding="{Binding RadixGlyph}" Header=" " 
                                                    IsReadOnly="True" CellStyle="{StaticResource GlyphColumnStyle}"/>
                                <DataGridTextColumn Binding="{Binding RadixName}" Header="Radix" 
                                                    IsReadOnly="True" CellStyle="{StaticResource NameColumnStyle}"/>
                                <DataGridTextColumn Binding="{Binding OrbText}" Header="Effective orb" 
                                                    IsReadOnly="True" CellStyle="{StaticResource NumberColumnStyle}"/>
                            </DataGrid.Columns>   
                        </DataGrid>
                    </ScrollViewer>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Margin="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Margin="6" Content="Help" HorizontalAlignment="Right" 
                    Command="{Binding HelpCommand}"/>
            <Button Margin="6" Content="Close" HorizontalAlignment="Right" 
                    Command="{Binding CloseCommand}"/>
        </StackPanel>
    </Grid>
</Window> 