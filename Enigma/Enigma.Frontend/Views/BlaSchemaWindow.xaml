<Window x:Class="Enigma.Frontend.Ui.Views.BlaSchemaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewModels="clr-namespace:Enigma.Frontend.Ui.ViewModels"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Medium"
        TextElement.FontSize="14"
        FontFamily="pack://application:,,,/MaterialDesignThemes.Wpf;component/Resources/Roboto/#Roboto"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Enigma - BLA Schema" Height="800" Width="1400"
        Loaded="Window_Loaded">
    <Window.DataContext>
        <viewModels:BlaSchemaViewModel/>
    </Window.DataContext>
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Margin="6,0,0,6" 
                   VerticalAlignment="Center" HorizontalAlignment="Left"
                   Text="BLA Schema" Name="Header"
                   Style="{StaticResource MaterialDesignHeadline4TextBlock}" 
                   FontWeight="Bold" />

        <!-- Chart Name -->
        <TextBlock Grid.Row="1" Margin="6,12,6,6" 
                   Text="{Binding ChartName}" Name="ChartNameText"
                   Style="{StaticResource MaterialDesignHeadline6TextBlock}" 
                   FontWeight="Bold"/>
        
        <!-- Main Content Area -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <Grid Margin="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="400"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column -->
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <!-- Correction for Black Moon -->
                    <TextBlock Text="Correction for Black Moon:" 
                               Style="{StaticResource MaterialDesignSubtitle1TextBlock}" 
                               Margin="0,8,0,4"/>
                    <ComboBox x:Name="BlackMoonCorrectionComboBox"
                              Margin="0,0,0,8" 
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              SelectedItem="{Binding SelectedBlackMoonCorrection}"
                              SelectionChanged="BlackMoonCorrectionComboBox_SelectionChanged">
                        <ComboBoxItem Content="Swiss Ephemeris"/>
                        <ComboBoxItem Content="Duval (Cees Jansen)"/>
                        <ComboBoxItem Content="Interpolated"/>
                    </ComboBox>

                    <!-- House System -->
                    <TextBlock Text="House System:" 
                               Style="{StaticResource MaterialDesignSubtitle1TextBlock}" 
                               Margin="0,8,0,4"/>
                    <ComboBox x:Name="HouseSystemComboBox"
                              Margin="0,0,0,8" 
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              SelectedItem="{Binding SelectedHouseSystem}"
                              SelectionChanged="HouseSystemComboBox_SelectionChanged">
                        <ComboBoxItem Content="Placidus"/>
                        <ComboBoxItem Content="Regiomontanus"/>
                        <ComboBoxItem Content="Campanus"/>
                        <ComboBoxItem Content="Alcabitius"/>
                        <ComboBoxItem Content="Koch"/>
                        <ComboBoxItem Content="Porphyrius"/>
                        <ComboBoxItem Content="Topocentric"/>
                    </ComboBox>

                    <!-- Checkboxes -->
                    <CheckBox x:Name="IncludeChironCheckBox"
                              Content="Include Chiron" 
                              Style="{StaticResource MaterialDesignCheckBox}" 
                              Margin="0,8,0,4"
                              IsChecked="{Binding IncludeChiron}"
                              Checked="IncludeChironCheckBox_Changed"
                              Unchecked="IncludeChironCheckBox_Changed"/>
                    <CheckBox x:Name="IncludeErisCheckBox"
                              Content="Include Eris" 
                              Style="{StaticResource MaterialDesignCheckBox}" 
                              Margin="0,8,0,16"
                              IsChecked="{Binding IncludeEris}"
                              Checked="IncludeErisCheckBox_Changed"
                              Unchecked="IncludeErisCheckBox_Changed"/>

                    <!-- Positions DataGrid -->
                    <TextBlock Text="Positions:" 
                               Style="{StaticResource MaterialDesignSubtitle1TextBlock}" 
                               Margin="0,8,0,4"/>
                    <DataGrid AutoGenerateColumns="False" 
                              Height="300" 
                              Margin="0,0,0,8"
                              Style="{StaticResource MaterialDesignDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Column 1" Width="*"/>
                            <DataGridTextColumn Header="Column 2" Width="*"/>
                            <DataGridTextColumn Header="Column 3" Width="*"/>
                            <DataGridTextColumn Header="Column 4" Width="*"/>
                            <DataGridTextColumn Header="Column 5" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>

                <!-- Right Column -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Elements/Crosses Section -->
                        <Border BorderBrush="{DynamicResource MaterialDesignDivider}" 
                                BorderThickness="0,0,0,1" 
                                Margin="0,0,0,16" 
                                Padding="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Elements/Crosses" 
                                           Style="{StaticResource MaterialDesignHeadline6TextBlock}" 
                                           Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Left subpart - DataGrid -->
                                    <DataGrid Grid.Column="0" 
                                              AutoGenerateColumns="False" 
                                              Height="200" 
                                              Margin="0,0,8,0"
                                              Style="{StaticResource MaterialDesignDataGrid}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Col 1" Width="*"/>
                                            <DataGridTextColumn Header="Col 2" Width="*"/>
                                            <DataGridTextColumn Header="Col 3" Width="*"/>
                                            <DataGridTextColumn Header="Col 4" Width="*"/>
                                            <DataGridTextColumn Header="Col 5" Width="*"/>
                                            <DataGridTextColumn Header="Col 6" Width="*"/>
                                            <DataGridTextColumn Header="Col 7" Width="*"/>
                                            <DataGridTextColumn Header="Col 8" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    
                                    <!-- Right subpart - Two diagrams side by side -->
                                    <Grid Grid.Column="1" Margin="8,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" 
                                                BorderBrush="{DynamicResource MaterialDesignDivider}" 
                                                BorderThickness="1" 
                                                Margin="0,0,4,0" 
                                                Background="{DynamicResource MaterialDesignPaper}">
                                            <TextBlock Text="Diagram 1" 
                                                       HorizontalAlignment="Center" 
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Column="1" 
                                                BorderBrush="{DynamicResource MaterialDesignDivider}" 
                                                BorderThickness="1" 
                                                Margin="4,0,0,0" 
                                                Background="{DynamicResource MaterialDesignPaper}">
                                            <TextBlock Text="Diagram 2" 
                                                       HorizontalAlignment="Center" 
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Dispositors Section -->
                        <Border BorderBrush="{DynamicResource MaterialDesignDivider}" 
                                BorderThickness="0,0,0,1" 
                                Margin="0,0,0,16" 
                                Padding="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Dispositors" 
                                           Style="{StaticResource MaterialDesignHeadline6TextBlock}" 
                                           Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Left subpart - DataGrid -->
                                    <DataGrid Grid.Column="0" 
                                              AutoGenerateColumns="False" 
                                              Height="200" 
                                              Margin="0,0,8,0"
                                              Style="{StaticResource MaterialDesignDataGrid}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Col 1" Width="*"/>
                                            <DataGridTextColumn Header="Col 2" Width="*"/>
                                            <DataGridTextColumn Header="Col 3" Width="*"/>
                                            <DataGridTextColumn Header="Col 4" Width="*"/>
                                            <DataGridTextColumn Header="Col 5" Width="*"/>
                                            <DataGridTextColumn Header="Col 6" Width="*"/>
                                            <DataGridTextColumn Header="Col 7" Width="*"/>
                                            <DataGridTextColumn Header="Col 8" Width="*"/>
                                            <DataGridTextColumn Header="Col 9" Width="*"/>
                                            <DataGridTextColumn Header="Col 10" Width="*"/>
                                            <DataGridTextColumn Header="Col 11" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    
                                    <!-- Right subpart - Diagram -->
                                    <Border Grid.Column="1" 
                                            BorderBrush="{DynamicResource MaterialDesignDivider}" 
                                            BorderThickness="1" 
                                            Margin="8,0,0,0" 
                                            Background="{DynamicResource MaterialDesignPaper}">
                                        <TextBlock Text="Diagram" 
                                                   HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Quadrants Section -->
                        <Border BorderBrush="{DynamicResource MaterialDesignDivider}" 
                                BorderThickness="0,0,0,1" 
                                Margin="0,0,0,16" 
                                Padding="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Quadrants" 
                                           Style="{StaticResource MaterialDesignHeadline6TextBlock}" 
                                           Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Left subpart - DataGrid -->
                                    <DataGrid Grid.Column="0" 
                                              AutoGenerateColumns="False" 
                                              Height="150" 
                                              Margin="0,0,8,0"
                                              Style="{StaticResource MaterialDesignDataGrid}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Col 1" Width="*"/>
                                            <DataGridTextColumn Header="Col 2" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    
                                    <!-- Right subpart - Diagram -->
                                    <Border Grid.Column="1" 
                                            BorderBrush="{DynamicResource MaterialDesignDivider}" 
                                            BorderThickness="1" 
                                            Margin="8,0,0,0" 
                                            Background="{DynamicResource MaterialDesignPaper}">
                                        <TextBlock Text="Diagram" 
                                                   HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Decanates Section -->
                        <Border BorderBrush="{DynamicResource MaterialDesignDivider}" 
                                BorderThickness="0,0,0,1" 
                                Margin="0,0,0,16" 
                                Padding="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Decanates" 
                                           Style="{StaticResource MaterialDesignHeadline6TextBlock}" 
                                           Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Left subpart - DataGrid -->
                                    <DataGrid Grid.Column="0" 
                                              AutoGenerateColumns="False" 
                                              Height="200" 
                                              Margin="0,0,8,0"
                                              Style="{StaticResource MaterialDesignDataGrid}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Col 1" Width="*"/>
                                            <DataGridTextColumn Header="Col 2" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    
                                    <!-- Right subpart - Diagram -->
                                    <Border Grid.Column="1" 
                                            BorderBrush="{DynamicResource MaterialDesignDivider}" 
                                            BorderThickness="1" 
                                            Margin="8,0,0,0" 
                                            Background="{DynamicResource MaterialDesignPaper}">
                                        <TextBlock Text="Diagram" 
                                                   HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Specifics Section -->
                        <Border BorderBrush="{DynamicResource MaterialDesignDivider}" 
                                BorderThickness="0,0,0,1" 
                                Margin="0,0,0,16" 
                                Padding="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Specifics" 
                                           Style="{StaticResource MaterialDesignHeadline6TextBlock}" 
                                           Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Left subpart - DataGrid -->
                                    <DataGrid Grid.Column="0" 
                                              AutoGenerateColumns="False" 
                                              Height="120" 
                                              Margin="0,0,8,0"
                                              Style="{StaticResource MaterialDesignDataGrid}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Col 1" Width="*"/>
                                            <DataGridTextColumn Header="Col 2" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    
                                    <!-- Right subpart - DataGrid -->
                                    <DataGrid Grid.Column="1" 
                                              AutoGenerateColumns="False" 
                                              Height="120" 
                                              Margin="8,0,0,0"
                                              Style="{StaticResource MaterialDesignDataGrid}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Col 1" Width="*"/>
                                            <DataGridTextColumn Header="Col 2" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Cycles Section -->
                        <Border BorderBrush="{DynamicResource MaterialDesignDivider}" 
                                BorderThickness="0,0,0,1" 
                                Margin="0,0,0,16" 
                                Padding="0,0,0,16">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Left subpart - Cyclic connections -->
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Cyclic connections" 
                                                   Style="{StaticResource MaterialDesignHeadline6TextBlock}" 
                                                   Margin="0,0,0,8"/>
                                        <DataGrid AutoGenerateColumns="False" 
                                                  Height="200" 
                                                  Style="{StaticResource MaterialDesignDataGrid}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Col 1" Width="*"/>
                                                <DataGridTextColumn Header="Col 2" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                    
                                    <!-- Right subpart - Shortened cycles -->
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="Shortened cycles" 
                                                   Style="{StaticResource MaterialDesignHeadline6TextBlock}" 
                                                   Margin="0,0,0,8"/>
                                        <DataGrid AutoGenerateColumns="False" 
                                                  Height="200" 
                                                  Style="{StaticResource MaterialDesignDataGrid}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Col 1" Width="*"/>
                                                <DataGridTextColumn Header="Col 2" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Position reinforcement Section -->
                        <Border BorderBrush="{DynamicResource MaterialDesignDivider}" 
                                BorderThickness="0,0,0,1" 
                                Margin="0,0,0,16" 
                                Padding="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Position reinforcement" 
                                           Style="{StaticResource MaterialDesignHeadline6TextBlock}" 
                                           Margin="0,0,0,8"/>
                                <DataGrid AutoGenerateColumns="False" 
                                          Height="150" 
                                          Style="{StaticResource MaterialDesignDataGrid}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Col 1" Width="*"/>
                                        <DataGridTextColumn Header="Col 2" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </ScrollViewer>

        <!-- Bottom buttons -->
        <StackPanel Grid.Row="3" Margin="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Margin="6 6 0 6" Content="Help" Command="{Binding HelpCommand}"/>
            <Button Margin="6 6 0 6" Content="Close" Command="{Binding CloseCommand}" />
        </StackPanel>
    </Grid>
</Window>
