<Window x:Class="Enigma.Frontend.Ui.Views.ProgCalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewModels="clr-namespace:Enigma.Frontend.Ui.ViewModels"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Medium"
        TextElement.FontSize="14"
        FontFamily="pack://application:,,,/MaterialDesignThemes.Wpf;component/Resources/Roboto/#Roboto"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Enigma - Progressive Calendar" Height="600" Width="800">
    <Window.DataContext>
        <viewModels:ProgCalViewModel />
    </Window.DataContext>
    <Grid Margin="6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" Margin="6,0,0,6"
                   VerticalAlignment="Center" HorizontalAlignment="Left"
                   Text="Progressive Calendar" Name="Header"
                   Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                   FontWeight="Bold" />

        <!-- Chart Name -->
        <TextBlock Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" Margin="6,12,6,6"
                   Text="{Binding ChartName}" Name="ChartNameText"
                   Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                   FontWeight="Bold" />
        <!-- Options -->
        <StackPanel Grid.Column="0" Grid.Row="2" Orientation="Vertical">
            <TextBox Margin="6 0" VerticalAlignment="Center"                   
                     materialDesign:HintAssist.Hint="Start date yyyy/mm/dd"
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                     Text="{Binding Date, Mode=TwoWay}"/>             
            <CheckBox Content="Extended period (100 days)"
                      Margin="6"
                      Style="{StaticResource MaterialDesignCheckBox}"
                      IsChecked="{Binding UseExtendedPeriod}"
                      Checked="UseExtPeriodCheckBox_Checked"
                      Unchecked="UseExtPeriodCheckBox_UnChecked" />
            <CheckBox Content="Include secundary directions"
                      Margin="6"
                      Style="{StaticResource MaterialDesignCheckBox}"
                      IsChecked="{Binding UseSecundary}"
                      Checked="UseSecundaryCheckBox_Checked"
                      Unchecked="UseSecundaryCheckBox_UnChecked" />
            <CheckBox Content="Include (contra) parallels"
                      Margin="6"
                      Style="{StaticResource MaterialDesignCheckBox}"
                      IsChecked="{Binding UseParallels}"
                      Checked="UseParallelsCheckBox_Checked"
                      Unchecked="UseParallelsCheckBox_UnChecked" />
        </StackPanel>
        
        
        <!-- Main Content Area -->

        <TabControl Grid.Column="1" Grid.Row="2">
            <TabItem Header="List">
                <Border Margin="6">
                    <DataGrid Grid.Row="5" x:Name="MomentsDataGrid"
                              AutoGenerateColumns="False"
                              Height="Auto"
                              Margin="12,0"
                              Style="{StaticResource MaterialDesignDataGrid}"
                              Background="#F0F8FF"
                              ItemsSource="{Binding ProgCalItems, Mode=TwoWay}"
                              VerticalAlignment="Top">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date/time" Width="Auto" Binding="{Binding DateTime, Mode=TwoWay}"
                                                IsReadOnly="True" CellStyle="{StaticResource NameColumnStyle}" />
                            <DataGridTextColumn Header="Method" Width="Auto" Binding="{Binding ProgType, Mode=TwoWay}"
                                                IsReadOnly="True" CellStyle="{StaticResource NameColumnStyle}" />
                            <DataGridTextColumn Header="" Width="Auto" Binding="{Binding ProgPointGlyph, Mode=TwoWay}"
                                                IsReadOnly="True" CellStyle="{StaticResource GlyphColumnStyle}" />
                            <DataGridTextColumn Header="" Width="Auto" Binding="{Binding AspectGlyph, Mode=TwoWay}"
                                                IsReadOnly="True" CellStyle="{StaticResource GlyphColumnStyle}" />
                            <DataGridTextColumn Header="" Width="Auto" Binding="{Binding RadixGlyph, Mode=TwoWay}"
                                                IsReadOnly="True" CellStyle="{StaticResource GlyphColumnStyle}" />
                            <DataGridTextColumn Header="Position" Width="Auto" Binding="{Binding ProgPointPosition, Mode=TwoWay}"
                                                IsReadOnly="True" CellStyle="{StaticResource NumberColumnStyle}" />
                            <DataGridTextColumn Header="" Width="Auto" Binding="{Binding SignGlyph, Mode=TwoWay}"
                                                IsReadOnly="True" CellStyle="{StaticResource GlyphColumnStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>              
                </Border>
                
            </TabItem>
            <TabItem Header="Aspects graph">
                <Border Margin="12" Background="{DynamicResource MaterialDesignCardBackground}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollViewer Grid.Row="0"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <ScottPlot:WpfPlot x:Name="ProgCalPeriodsPlot"
                                                   Background="{DynamicResource MaterialDesignPaper}"
                                                   Margin="4"/>
                                <TextBlock x:Name="NoPeriodsText"
                                           Text="No periods available"
                                           Foreground="{DynamicResource MaterialDesignBody}"
                                           FontStyle="Italic"
                                           FontSize="16"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed" />
                            </Grid>
                        </ScrollViewer>
                        <ScottPlot:WpfPlot x:Name="ProgCalAxisPlot"
                                           Grid.Row="1"
                                           Height="65"
                                           Margin="4,0,4,4"
                                           Background="{DynamicResource MaterialDesignPaper}" />
                    </Grid>
                </Border>
            </TabItem>

        </TabControl>
        <!-- Bottom buttons -->
        <StackPanel Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="2" Margin="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Margin="6 6 0 6" Content="Help" Command="{Binding HelpCommand}" />
            <Button Margin="6 6 0 6" Content="Close" Command="{Binding CloseCommand}" />
        </StackPanel>
    </Grid>
</Window>