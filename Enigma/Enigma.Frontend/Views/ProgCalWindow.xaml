<Window x:Class="Enigma.Frontend.Ui.Views.ProgCalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewModels="clr-namespace:Enigma.Frontend.Ui.ViewModels"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Medium"
        TextElement.FontSize="14"
        FontFamily="pack://application:,,,/MaterialDesignThemes.Wpf;component/Resources/Roboto/#Roboto"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Enigma - Progressive Calendar" Height="600" Width="800">
    <Window.DataContext>
        <viewModels:ProgCalViewModel />
    </Window.DataContext>
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Margin="6,0,0,6"
                   VerticalAlignment="Center" HorizontalAlignment="Left"
                   Text="Progressive Calendar" Name="Header"
                   Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                   FontWeight="Bold" />

        <!-- Chart Name -->
        <TextBlock Grid.Row="1" Margin="6,12,6,6"
                   Text="{Binding ChartName}" Name="ChartNameText"
                   Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                   FontWeight="Bold" />
        <!-- Options -->
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <CheckBox Content="Aspects"
                      Margin="6"
                      Style="{StaticResource MaterialDesignCheckBox}"
                      IsChecked="{Binding UseAspects}"
                      Checked="UseAspectsCheckBox_Checked"
                      Unchecked="UseAspectsCheckBox_UnChecked" />
            <CheckBox Content="Parallels"
                      Margin="6"
                      Style="{StaticResource MaterialDesignCheckBox}"
                      IsChecked="{Binding UseParallels}"
                      Checked="UseParallelsCheckBox_Checked"
                      Unchecked="UseParallelsCheckBox_UnChecked" />
        </StackPanel>
        <!-- Main Content Area -->

        <TabControl Grid.Row="3">
            <TabItem Header="List">
                <Border Margin="6">
                    <DataGrid Grid.Row="5" x:Name="ProgCalList"
                              AutoGenerateColumns="False"
                              Height="Auto"
                              Margin="12,0"
                              Style="{StaticResource MaterialDesignDataGrid}"
                              Background="#F0F8FF"
                              ItemsSource="{Binding ProgCalItems, Mode=TwoWay}"
                              VerticalAlignment="Top">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date/time" Width="Auto" Binding="{Binding DateTime, Mode=TwoWay}"
                                                IsReadOnly="True" CellStyle="{StaticResource NameColumnStyle}" />
                            <DataGridTextColumn Header="Method" Width="Auto" Binding="{Binding ProgType, Mode=TwoWay}"
                                                IsReadOnly="True" CellStyle="{StaticResource NameColumnStyle}" />
                            <DataGridTextColumn Header="" Width="Auto" Binding="{Binding ProgPointGlyph, Mode=TwoWay}"
                                                IsReadOnly="True" CellStyle="{StaticResource GlyphColumnStyle}" />
                            <DataGridTextColumn Header="" Width="Auto" Binding="{Binding AspectGlyph, Mode=TwoWay}"
                                                IsReadOnly="True" CellStyle="{StaticResource GlyphColumnStyle}" />
                            <DataGridTextColumn Header="" Width="Auto" Binding="{Binding RadixGlyph, Mode=TwoWay}"
                                                IsReadOnly="True" CellStyle="{StaticResource GlyphColumnStyle}" />
                            <DataGridTextColumn Header="Position" Width="Auto" Binding="{Binding ProgPointPosition, Mode=TwoWay}"
                                                IsReadOnly="True" CellStyle="{StaticResource NumberColumnStyle}" />
                            <DataGridTextColumn Header="" Width="Auto" Binding="{Binding SignGlyph, Mode=TwoWay}"
                                                IsReadOnly="True" CellStyle="{StaticResource GlyphColumnStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>              
                </Border>
                
            </TabItem>
            <TabItem Header="Graph">
                
            </TabItem>

        </TabControl>
        <!-- Bottom buttons -->
        <StackPanel Grid.Row="4" Margin="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Margin="6 6 0 6" Content="Help" Command="{Binding HelpCommand}" />
            <Button Margin="6 6 0 6" Content="Close" Command="{Binding CloseCommand}" />
        </StackPanel>
    </Grid>
</Window>