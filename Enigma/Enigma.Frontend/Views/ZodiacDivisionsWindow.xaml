<Window x:Class="Enigma.Frontend.Ui.Views.ZodiacDivisionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:Enigma.Frontend.Ui.Views"
        xmlns:viewModels="clr-namespace:Enigma.Frontend.Ui.ViewModels"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Medium"
        TextElement.FontSize="14"
        FontFamily="pack://application:,,,/MaterialDesignThemes.Wpf;component/Resources/Roboto/#Roboto"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Enigma - Zodiac Divisions" Height="740" Width="1000">
    
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30*"/>
            <ColumnDefinition Width="70*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Title spanning full width -->
        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" 
                   Margin="6,0,0,12" VerticalAlignment="Center" HorizontalAlignment="Left"
                   Text="Zodiac Divisions Calculator" Name="Header"
                   Style="{StaticResource MaterialDesignHeadline4TextBlock}" 
                   FontWeight="Bold" />
        
        <!-- Left Column - Options -->
        <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="6,0,12,0">
                <!-- Description Text Block -->
                <TextBlock Margin="0,0,0,16" TextWrapping="Wrap" 
                           Style="{StaticResource MaterialDesignBody1TextBlock}">
                    This tool calculates various zodiac divisions for given longitudes. 
                    Select your preferred methods for decans, dodecatemoria, and terms/bounds. 
                    The results will be displayed in the table on the right.
                </TextBlock>
                
                <!-- Options Section -->
                <TextBlock Margin="0,0,0,8" Text="Options" 
                           Style="{StaticResource MaterialDesignHeadline6TextBlock}" 
                           FontWeight="Bold" />
                
                <!-- Decans Options -->
                <GroupBox Margin="0,8,0,8" Style="{StaticResource MaterialDesignGroupBox}" Header="Decans">
                    <StackPanel>
                        <RadioButton Margin="16,2,0,2" Content="Signs" 
                                     Style="{StaticResource MaterialDesignRadioButton}"
                                     IsChecked="{Binding DecansSignsSelected}" />
                        <RadioButton Margin="16,2,0,2" Content="Planets" 
                                     Style="{StaticResource MaterialDesignRadioButton}"
                                     IsChecked="{Binding DecansPlanetsSelected}" />
                    </StackPanel>
                </GroupBox>
                
                <!-- Dodecatemoria Options -->
                <GroupBox Margin="0,16,0,8" Style="{StaticResource MaterialDesignGroupBox}" Header="Dodecatemoria">
                    <StackPanel>
                        <RadioButton Margin="16,2,0,2" Content="Original" 
                                     Style="{StaticResource MaterialDesignRadioButton}"
                                     IsChecked="{Binding DodecatsOriginalSelected}" />
                        <RadioButton Margin="16,2,0,2" Content="Paulus" 
                                     Style="{StaticResource MaterialDesignRadioButton}"
                                     IsChecked="{Binding DodecatsPaulusSelected}" />
                    </StackPanel>
                </GroupBox>
                
                <!-- Terms/Bounds Options -->
                <GroupBox Margin="0,16,0,8" Style="{StaticResource MaterialDesignGroupBox}" Header="Terms">
                    <StackPanel>
                        <RadioButton Margin="16,2,0,2" Content="Egyptian" 
                                     Style="{StaticResource MaterialDesignRadioButton}"
                                     IsChecked="{Binding TermsEgyptianSelected}" />
                        <RadioButton Margin="16,2,0,2" Content="Ptolemy" 
                                     Style="{StaticResource MaterialDesignRadioButton}"
                                     IsChecked="{Binding TermsPtolemySelected}" />
                    </StackPanel>
                </GroupBox>
  
            </StackPanel>
        </ScrollViewer>
        
        <!-- Right Column - Results Table -->
        <Grid Grid.Row="1" Grid.Column="1" Margin="12,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>                
            </Grid.RowDefinitions>
            
            <!-- Table Header -->
            <TextBlock Grid.Row="0" Margin="0,0,0,8" Text="Results" 
                       Style="{StaticResource MaterialDesignHeadline6TextBlock}" 
                       FontWeight="Bold" />
            
            <!-- DataGrid -->
            <DataGrid Grid.Row="1" 
                      materialDesign:DataGridAssist.CellPadding="4 2 2 2"
                      materialDesign:DataGridAssist.ColumnHeaderPadding="4 2 2 2"
                      CanUserAddRows="False" CanUserSortColumns="False"
                      AutoGenerateColumns="False"
                      HeadersVisibility="All"
                      ItemsSource="{Binding ZodiacDivisionsResults}"
                      SelectionUnit="FullRow"
                      IsReadOnly="True">
                <!-- DataGrid.Resources>
                    <Style TargetType="TextBlock" x:Key="GlyphTextBlockStyle">
                        <Setter Property="FontFamily" Value="/font/EnigmaAstrologyBLA2.ttf#EnigmaAstrologyBLA2"/>
                        <Setter Property="FontSize" Value="16"/>
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                </ -->
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Longitude}" Header=" " 
                                        CellStyle="{StaticResource NumberColumnStyle}"
                                        Width="60"/>
                    <DataGridTextColumn Binding="{Binding Planet}" Header="Planet" 
                                        CellStyle="{StaticResource GlyphColumnStyle}"
                                        Width="60"/>
                    <DataGridTextColumn Binding="{Binding Signs}" Header="Signs" 
                                        CellStyle="{StaticResource GlyphColumnStyle}"
                                        Width="80"/>
                    <DataGridTextColumn Binding="{Binding Decans}" Header="Decans" 
                                        CellStyle="{StaticResource GlyphColumnStyle}"
                                        Width="80"/>
                    <DataGridTextColumn Binding="{Binding Dodecatemoria}" Header="Dodecatemoria" 
                                        CellStyle="{StaticResource GlyphColumnStyle}"
                                        Width="100"/>
                    <DataGridTextColumn Binding="{Binding Bounds}" Header="Bounds" 
                                        CellStyle="{StaticResource GlyphColumnStyle}"
                                        Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
            
            <!-- Buttons at bottom -->
            <StackPanel Grid.Row="2" Grid.ColumnSpan="3" VerticalAlignment="Bottom" HorizontalAlignment="Right" 
                        Orientation="Horizontal" Margin="0,0,0,8">
                <Button Margin="6,0,6,0" Width="80" Content="Help" 
                        HorizontalAlignment="Right"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Command="{Binding HelpCommand}" />
                <Button Margin="6,0,6,0" Width="80" Content="OK"
                        HorizontalAlignment="Right"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Command="{Binding OkCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window> 